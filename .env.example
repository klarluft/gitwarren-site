# Cloudflare Web Analytics site token.
#
# Get it from the Cloudflare dashboard: Analytics & Logs > Web Analytics >
# Add a site (gitwarren.com) > "JS snippet", where it appears as
# data-cf-beacon='{"token": "..."}'. Copy just the token.
#
# Set the same value in Workers Builds > Settings > Variables so production
# deploys report. Leaving it unset emits no beacon and measures nothing, which
# is what preview and local builds should do.
PUBLIC_CF_BEACON_TOKEN=
