---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div
  class="flex flex-col gap-2 rounded-[11px] border border-line bg-surface p-card sm:gap-3 sm:rounded-xl"
>
  <h3 class="text-cardtitle font-semibold">{title}</h3>
  <p class="text-cardbody text-muted"><slot /></p>
</div>
