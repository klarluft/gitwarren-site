---
import Wordmark from "./Wordmark.astro";
import { DOCS_INDEX, REPO } from "../config";

// Absolute, so they still work from the 404 page and from a guide rather than
// scrolling to nothing. On the front page the browser treats them as
// same-document navigation and scrolls as usual.
const links = [
  { label: "How it works", href: "/#how-it-works" },
  { label: "Your machines", href: "/#your-machines" },
  { label: "Agents", href: "/#agents" },
  { label: "Guides", href: DOCS_INDEX },
  { label: "Source", href: REPO },
];
---

<header class="border-b border-line">
  <nav
    class="mx-auto flex w-full max-w-page items-center justify-between px-gutter py-[clamp(1.125rem,0.8511rem+1.1236vw,1.75rem)]"
  >
    <Wordmark />

    <div class="flex items-center gap-[34px] text-[15px]">
      <div class="hidden items-center gap-[26px] lg:flex">
        {
          links.map(({ label, href }) => (
            <a href={href} class="text-muted transition-colors hover:text-white">
              {label}
            </a>
          ))
        }
      </div>

      <a
        href="/#download"
        class="flex min-h-[44px] items-center rounded-[7px] bg-accent px-[18px] font-medium text-ground transition-colors hover:bg-[#f7c344] sm:min-h-0 sm:px-5 sm:py-[10px]"
      >
        Download
      </a>
    </div>
  </nav>
</header>
