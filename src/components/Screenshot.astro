---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { srcset } from "../lib/images";

interface Props {
  src: ImageMetadata;
  /** Portrait crop swapped in below 640px, where the wide shot is unreadable. */
  narrowSrc?: ImageMetadata;
  alt: string;
  caption?: string;
  /** The macOS traffic lights, on the hero frame only. */
  dots?: boolean;
  /** Above the fold: load eagerly and raise its priority. */
  eager?: boolean;
  /**
   * A silent loop played over the image, from 640px up.
   *
   * The image stays underneath as the poster: it is the LCP element, it is
   * what shows until the first frame decodes, and it is what a viewer with
   * reduced motion or a failed download sees. Below 640px the portrait crop
   * is the whole story - the wide video would be unreadable there anyway.
   */
  video?: { webm: string; mp4: string };
  class?: string;
}

const {
  src,
  narrowSrc,
  alt,
  caption,
  dots = false,
  eager = false,
  video,
  class: className,
} = Astro.props;

const WIDE_WIDTHS = [640, 880, 1040, 1560, 2080];
const NARROW_WIDTHS = [390, 480, 640, 780, 960];

// The frame tops out at 1040px and is full-bleed inside the gutters below
// that. `sizes` is parsed without an element context, so it cannot reference
// the gutter custom property — these are deliberately slightly generous
// approximations of it.
const WIDE_SIZES = "(min-width: 1240px) 1040px, 92vw";
const NARROW_SIZES = "100vw";

const [wideAvif, wideWebp, fallback] = await Promise.all([
  srcset(src, WIDE_WIDTHS, "avif"),
  srcset(src, WIDE_WIDTHS, "webp"),
  getImage({ src, width: 1040, format: "jpeg", quality: 80 }),
]);

const narrow = narrowSrc
  ? {
      avif: await srcset(narrowSrc, NARROW_WIDTHS, "avif"),
      webp: await srcset(narrowSrc, NARROW_WIDTHS, "webp"),
      ratio: `${narrowSrc.width}/${narrowSrc.height}`,
    }
  : null;

const wideRatio = `${src.width}/${src.height}`;
---

<figure class:list={["flex flex-col gap-stack", className]}>
  <div
    class:list={[
      "relative w-full overflow-hidden rounded-[11px] border border-line-soft bg-well sm:rounded-xl",
      dots && "shadow-[0_40px_80px_-30px_rgba(0,0,0,0.9)]",
    ]}
    data-shot
    data-art={narrow ? "" : null}
    style={`--shot-ratio:${wideRatio};--shot-ratio-narrow:${narrow?.ratio ?? wideRatio}`}
  >
    {
      dots && (
        <div class="absolute top-[26px] left-6 z-[2] hidden gap-2 sm:flex" aria-hidden="true">
          <span class="size-[11px] rounded-full bg-dot" />
          <span class="size-[11px] rounded-full bg-dot" />
          <span class="size-[11px] rounded-full bg-dot" />
        </div>
      )
    }

    <picture>
      {
        narrow && (
          <>
            <source
              media="(max-width: 639px)"
              type="image/avif"
              srcset={narrow.avif}
              sizes={NARROW_SIZES}
            />
            <source
              media="(max-width: 639px)"
              type="image/webp"
              srcset={narrow.webp}
              sizes={NARROW_SIZES}
            />
          </>
        )
      }
      <source type="image/avif" srcset={wideAvif} sizes={WIDE_SIZES} />
      <source type="image/webp" srcset={wideWebp} sizes={WIDE_SIZES} />
      <img
        src={fallback.src}
        alt={alt}
        width={src.width}
        height={src.height}
        loading={eager ? "eager" : "lazy"}
        decoding={eager ? "sync" : "async"}
        fetchpriority={eager ? "high" : "auto"}
        class="block h-auto w-full"
      />
    </picture>

    {
      video && (
        <>
          <video
            class="absolute inset-0 hidden h-full w-full object-cover sm:block"
            autoplay
            muted
            loop
            playsinline
            disablepictureinpicture
            preload="metadata"
            aria-hidden="true"
            tabindex="-1"
            data-shot-video
          >
            <source src={video.webm} type="video/webm" />
            <source src={video.mp4} type="video/mp4" />
          </video>
          {/*
            Taken out of the document, not just hidden: `autoplay` would still
            fetch a display:none video, and the whole point of the preference
            is not to be shown motion. Inline so it runs before the browser
            gets far with the download.
          */}
          <script is:inline>
            if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
              document.querySelectorAll("[data-shot-video]").forEach((v) => v.remove());
            }
          </script>
        </>
      )
    }
  </div>

  {
    caption && (
      <figcaption class="max-w-[660px] text-caption text-faint">{caption}</figcaption>
    )
  }
</figure>

<style>
  /* Reserve the right box before the image loads. The narrow crop has a
     different aspect ratio, so it needs its own below the swap point. The
     ratios come from an inline style on the frame, set above. */
  [data-shot] img {
    aspect-ratio: var(--shot-ratio);
  }

  @media (max-width: 639px) {
    [data-shot][data-art] img {
      aspect-ratio: var(--shot-ratio-narrow);
    }
  }
</style>
