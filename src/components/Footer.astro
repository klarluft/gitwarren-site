---
import { LEGAL, LICENCE, PRIVACY, RELEASES, REPO } from "../config";
import FooterRabbit from "./FooterRabbit.astro";

const links = [
  { label: "GitHub", href: REPO },
  { label: "Licence", href: LICENCE },
  { label: "Releases", href: RELEASES },
  { label: "Privacy", href: PRIVACY },
  { label: "Legal notice", href: LEGAL },
];
---

<!-- `relative` anchors the rabbit, which climbs out of this top border. -->
<footer class="relative mt-footertop border-t border-line">
  <FooterRabbit />

  <div
    class="mx-auto flex w-full max-w-page flex-col gap-4 px-gutter py-[clamp(1.625rem,1.4062rem+0.8989vw,2.125rem)] text-[13px] text-faint sm:flex-row sm:items-center sm:justify-between sm:text-sm"
  >
    <span>GitWarren &mdash; a Klarluft B.V. project</span>

    <!-- Five links no longer fit one line on a narrow phone, so they wrap
         rather than overflowing. -->
    <nav class="flex flex-wrap gap-x-7 gap-y-2">
      {
        links.map(({ label, href }) => (
          <a href={href} class="transition-colors hover:text-white">
            {label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
