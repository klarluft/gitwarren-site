---
import { Image } from "astro:assets";
import Button from "./Button.astro";
import logo from "../assets/logo.png";
import type { Downloads } from "../lib/releases";

interface Props {
  downloads: Downloads;
}

const { downloads } = Astro.props;
---

<section
  id="download"
  class="mx-auto flex w-full max-w-page flex-col items-center gap-stack px-gutter pt-section"
>
  <Image
    src={logo}
    alt="The GitWarren app icon"
    width={144}
    height={144}
    class="block size-[72px]"
  />

  <h2 class="max-w-[780px] text-center font-display text-h2xl">
    Read the diff before you push it.
  </h2>

  <div
    class="mt-2.5 flex w-full flex-col items-stretch gap-[11px] sm:w-auto sm:flex-row sm:items-center sm:gap-[14px]"
  >
    {/*
      This section is the explicit platform picker, so only the architecture
      is adjusted here — never the label. Swapping "macOS" to "Windows" would
      duplicate the button beside it.
    */}
    <Button href={downloads.macosArm} data-download="macos">Download for macOS</Button>
    <Button href={downloads.windows} variant="secondary">Windows</Button>
    <Button href={downloads.linux} data-download="linux" variant="secondary">Linux</Button>
  </div>

  <p class="text-center font-mono text-note text-faint">
    Free and open source under GPL-3.0
  </p>
</section>
