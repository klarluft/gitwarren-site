---
import { Image } from "astro:assets";
import HeroHalo from "./HeroHalo.astro";
import Eyebrow from "./Eyebrow.astro";
import Button from "./Button.astro";
import Screenshot from "./Screenshot.astro";
import logo from "../assets/logo.png";
import hero from "../assets/hero.png";
import heroMp4 from "../assets/hero.mp4";
import heroWebm from "../assets/hero.webm";
import narrow from "../assets/narrow.png";
import { REPO } from "../config";
import type { Downloads } from "../lib/releases";

interface Props {
  downloads: Downloads;
}

const { downloads } = Astro.props;

// Quiet enough to stay a footnote, obvious enough to be clickable.
const alt =
  "underline decoration-dotted decoration-faint/50 underline-offset-4 transition-colors hover:text-ink hover:decoration-faint";
---

<section class="relative overflow-hidden">
  <HeroHalo />

  <div
    class="relative mx-auto flex w-full max-w-page flex-col items-start gap-herostack px-gutter pt-herotop sm:items-center"
  >
    <Image
      src={logo}
      alt="The GitWarren logo"
      width={336}
      height={336}
      loading="eager"
      fetchpriority="high"
      class="hero-logo block"
    />

    <Eyebrow>Local review for AI-written code</Eyebrow>

    <h1 class="max-w-[940px] font-display text-h1 sm:text-center">
      Review what your agents wrote,<br class="hidden lg:inline" /> before GitHub
      ever sees it.
    </h1>

    <p class="max-w-[690px] text-lead text-muted sm:text-center">
      An agent finishes a task and leaves you a worktree full of changes that
      aren&#39;t committed yet. Every other review tool waits for a pull request.
      GitWarren reads the worktree directly &mdash; staged, unstaged and
      untracked &mdash; so you read the diff on your own machine first.
    </p>

    <div
      class="mt-1.5 flex w-full flex-col items-stretch gap-[11px] sm:mt-2 sm:w-auto sm:flex-row sm:items-center sm:gap-[14px]"
    >
      <Button href={downloads.macosArm} data-download="primary">
        <svg
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3v13"></path>
          <path d="m7 12 5 5 5-5"></path>
          <path d="M4 21h16"></path>
        </svg>
        <span data-download-label>Download for macOS</span>
      </Button>
      <Button href={REPO} variant="secondary">Source on GitHub</Button>
    </div>

    {/*
      The copy is the artboard's, word for word. The platform names are now
      the links to their own builds, so an Intel Mac has a correct path
      without relying on the detection script below.
    */}
    <p class="w-full text-center font-mono text-note text-faint">
      {downloads.version}{" · "}
      <a href={downloads.macosArm} class={alt}>Apple silicon</a>{" and "}
      <a href={downloads.macosIntel} class={alt}>Intel</a>{" · "}
      <a href={downloads.windows} class={alt}>Windows</a>{" and "}
      <a href={downloads.linux} class={alt}>Linux</a>{" too"}
    </p>

    {/*
      The Homebrew path, repeated from the Download section so a macOS
      developer arriving at the top of the page does not have to scroll for
      it. `select-all` so one click selects the whole command.
    */}
    <p class="w-full text-center font-mono text-note text-faint">
      or <code class="text-accent select-all">brew install --cask klarluft/tap/gitwarren</code>
    </p>

    <Screenshot
      src={hero}
      narrowSrc={narrow}
      video={{ webm: heroWebm, mp4: heroMp4 }}
      alt="A GitWarren review showing uncommitted changes folded into the diff"
      dots
      eager
      class="mt-[26px] w-full max-w-shot sm:mt-[46px]"
    />
  </div>
</section>

<style>
  .hero-logo {
    width: clamp(6.5rem, 4.747rem + 7.191vw, 10.5rem);
    height: auto;
    filter: drop-shadow(0 0 40px rgba(255, 77, 157, 0.45));
  }

  @media (min-width: 640px) {
    .hero-logo {
      filter: drop-shadow(0 0 60px rgba(255, 77, 157, 0.45))
        drop-shadow(0 0 30px rgba(53, 214, 196, 0.35));
    }
  }
</style>
