---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import BeforeCommit from "../components/BeforeCommit.astro";
import Agents from "../components/Agents.astro";
import YourMachines from "../components/YourMachines.astro";
import TwoShells from "../components/TwoShells.astro";
import LocalByConstruction from "../components/LocalByConstruction.astro";
import Download from "../components/Download.astro";
import Footer from "../components/Footer.astro";
import PlatformDownloads from "../components/PlatformDownloads.astro";
import { assertResolved, fetchDownloads } from "../lib/releases";
import { FALLBACK_VERSION, LICENCE, REPO } from "../config";

// Resolved once at build time and handed to both places that link downloads.
// A production build that could not read the API stops here rather than
// deploying fallback links over a page that was correct — see assertResolved.
const downloads = await fetchDownloads(FALLBACK_VERSION);
assertResolved(downloads, import.meta.env.DEV);

const site = (Astro.site ?? new URL("https://gitwarren.com")).href;

// What a search engine is told this page is about. Every value is something
// the page already says or links; the download URLs are the same ones the
// buttons carry, so a rich result can offer the installer directly.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "GitWarren",
  url: site,
  description:
    "Code review for your own machines and your own agents. Reads the worktree directly — staged, unstaged and untracked — so you can review what an AI coding agent wrote before it becomes a commit, on whichever of your machines it wrote it on. Desktop app or browser tab; reaches other machines over SSH, WSL or your own tailnet.",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Windows, Linux",
  softwareVersion: downloads.version.replace(/^v/, ""),
  license: LICENCE,
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  downloadUrl: [
    downloads.macosArm,
    downloads.macosIntel,
    downloads.windows,
    downloads.linux,
    downloads.linuxArm,
  ],
  sameAs: [REPO],
  author: { "@type": "Organization", name: "Klarluft", url: "https://klarluft.com" },
  keywords:
    "code review, git, diff, uncommitted changes, worktree, AI coding agents, Claude Code, Codex, MCP server, Claude Code plugin, Gemini CLI extension, local-first, self-hosted, SSH, WSL, Tailscale, tailnet, headless, remote code review",
};
---

<Layout
  title="GitWarren — review what your agents wrote, before GitHub ever sees it"
  description="Code review for your own machines and your own agents. GitWarren reads the worktree directly — staged, unstaged and untracked — so you read an agent's diff before it becomes a commit, on whichever of your machines it is on. Desktop app or browser tab, over SSH, WSL or your own tailnet."
  structuredData={structuredData}
>
  <Nav />
  <main>
    <Hero downloads={downloads} />
    <BeforeCommit />
    <Agents />
    <YourMachines />
    <TwoShells />
    <LocalByConstruction />
    <Download downloads={downloads} />
  </main>
  <Footer />
  <PlatformDownloads downloads={downloads} />
</Layout>
