# Turn the `engines` ranges in package.json into an error rather than a
# warning. npm 11.6 silently prunes lockfile entries for dependencies reached
# only through an optional platform package (@emnapi/*, via sharp's
# @img/sharp-wasm32) and then accepts their absence; every other version
# rejects the result, so `npm ci` breaks on CI and nowhere else. Failing at
# install time is much cheaper than failing in a deploy.
engine-strict=true
